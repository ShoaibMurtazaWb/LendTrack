# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App origin (local vs production)
# Local:  http://localhost:3000
# Vercel: https://lend-track-psi.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Nodemailer + any SMTP provider) ─────────────────────────────────
# Works with Gmail, SendGrid, Mailgun, Resend SMTP, Amazon SES, etc.
#
# Gmail example — SMTP_PASS is a Google App Password (16 chars, no spaces):
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LendTrack <you@example.com>

# Daily cron for loan reminders (Vercel Cron sends GET with Bearer token)
# GET|POST /api/cron/loan-reminders  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=
